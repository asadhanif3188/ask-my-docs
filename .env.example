# --- Database ---
DATABASE_URL=postgresql://rag:rag@localhost:5432/askmydocs

# --- Auth ---
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- LLM provider (generation) ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=

# --- Contextual retrieval: cheap model for one-line document summaries ---
SUMMARY_MODEL=claude-haiku-4-5-20251001

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# Optional: where to cache the BGE model weights (~5.4GB for embedder+reranker).
# Leave blank for the HF default (~/.cache/huggingface/hub).
HF_CACHE_DIR=

# --- Reranker ---
RERANKER_MODEL=BAAI/bge-reranker-base
RETRIEVE_TOP_K=50
RERANK_TOP_K=5

# --- Limits & cost caps ---
RATE_LIMIT_PER_MINUTE=30
ORG_DAILY_TOKEN_BUDGET=500000

# --- Eval gates (CI fails below these) ---
EVAL_MIN_FAITHFULNESS=0.85
EVAL_MIN_CONTEXT_RECALL=0.80

# Tenant the evals query against — a normal org, no auth bypass. Ingestion is keyed
# by (org_id, source_uri), so naming a NEW org re-embeds the whole corpus for it.
# Point this at an org that already holds the corpus and seeding does no work.
EVAL_ORG_NAME=eval
# Ragas judge model. Empty = LLM_MODEL.
EVAL_JUDGE_MODEL=claude-haiku-4-5-20251001
